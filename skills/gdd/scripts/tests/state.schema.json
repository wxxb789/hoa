{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent_run state.json (test oracle)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "agent",
    "state",
    "exit",
    "cwd",
    "started",
    "ended",
    "duration_s",
    "run_dir",
    "pid",
    "agent_pid",
    "session_id",
    "backend"
  ],
  "properties": {
    "name": {"type": "string"},
    "agent": {"type": "string"},
    "state": {"type": "string", "enum": ["running", "done", "failed", "killed", "unknown"]},
    "exit": {"type": ["integer", "null"]},
    "cwd": {"type": "string"},
    "started": {"type": "string"},
    "ended": {"type": ["string", "null"]},
    "duration_s": {"type": ["number", "null"]},
    "run_dir": {"type": "string"},
    "pid": {"type": ["integer", "null"]},
    "agent_pid": {"type": ["integer", "null"]},
    "session_id": {"type": "string"},
    "backend": {"type": "string"},
    "model": {"type": ["string", "null"]},
    "thinking": {"type": ["string", "null"]},
    "max_time": {"type": ["string", "null"]},
    "resumed_from": {"type": ["string", "null"]},
    "spawn": {"type": "object"},
    "pid_identity": {"type": "string"},
    "agent_pid_identity": {"type": "string"},
    "turns": {"type": "integer"},
    "tool_calls": {"type": "integer"},
    "usage": {"type": "object"},
    "cost_usd": {"type": ["number", "null"]},
    "answer_chars": {"type": "integer"},
    "error": {"type": "string"},
    "errors": {"type": "array"},
    "note": {"type": "string"},
    "stale_recovered": {"type": "boolean"},
    "stream_incomplete": {"type": "boolean"},
    "events_bytes": {"type": "integer"},
    "events_bytes_total": {"type": "integer"},
    "events_truncated": {"type": "boolean"},
    "events_dropped_bytes": {"type": "integer"},
    "turns_partial": {"type": "boolean"},
    "tool_calls_partial": {"type": "boolean"},
    "cost_partial": {"type": "boolean"}
  }
}
